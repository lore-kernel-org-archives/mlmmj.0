Hello together,

first of all thank you for mlmmj, I was searching
for a replacement for my (dead?) ecartis installation
and that's when I found mlmmj.

Attached is a patch that let's you disable the automatic bounce  
handling and for example set the bounce address to  
postmaster@domain.com. I needed this because the subscriptions etc.  
are automatically generated by another system and I need to  
fix/unsubscribe the people there.

If all goes well mlmmj will be pushed out to 1.500+ servers
as transparent replacement for ecartis at the end of April :-)

Cheers,
Thomas


--=_2o3bqj0up8e8
Content-Type: text/x-diff;
	charset=ISO-8859-1;
	name="mlmmj-staticbounceaddr.patch"
Content-Disposition: attachment;
	filename="mlmmj-staticbounceaddr.patch"
Content-Transfer-Encoding: quoted-printable

diff -u -r -p mlmmj-1.2.15/TUNABLES mlmmj.bounceaddr/TUNABLES
--- mlmmj-1.2.15/TUNABLES=09Sat Mar  3 18:21:58 2007
+++ mlmmj.bounceaddr/TUNABLES=09Sat Feb 23 01:49:08 2008
@@ -192,3 +192,8 @@ to specify several entries (one pr. line
=20
    If this is set, no reject notifications caused by violation of maxmailsi=
ze
    will be sent.
+
+ =B7 staticbounceaddr      =09(normal)
+
+   If this is set, the bounce address (Return-Path:) will be fixed     =20
+   to this address in case you need to disable automatic bounce handling.
diff -u -r -p mlmmj-1.2.15/src/mlmmj-send.c mlmmj.bounceaddr/src/mlmmj-send.=
c
--- mlmmj-1.2.15/src/mlmmj-send.c=09Wed Dec  6 14:19:10 2006
+++ mlmmj.bounceaddr/src/mlmmj-send.c=09Sat Feb 23 01:41:21 2008
@@ -102,12 +102,19 @@ char *get_index_from_filename(const char
 }
=20
 char *bounce_from_adr(const char *recipient, const char *listadr,
-=09=09      const char *listdelim, const char *mailfilename)
+=09=09      const char *listdelim, const char *mailfilename,
+=09=09      const char *listdir)
 {
 =09char *bounceaddr, *myrecipient, *mylistadr, *mylistdelim;
 =09char *indexstr, *listdomain, *a =3D NULL, *mymailfilename;
+=09char *staticbounceaddr;
 =09size_t len;
=20
+=09staticbounceaddr =3D ctrlvalue(listdir, "staticbounceaddr");
+=09if (staticbounceaddr) {
+=09=09return staticbounceaddr;
+=09}
+
 =09mymailfilename =3D mystrdup(mailfilename);
 =09if (!mymailfilename) {
 =09=09return NULL;
@@ -629,7 +636,7 @@ int send_mail_many_list(int sockfd, cons
 =09=09=09=09=09    hdrs, hdrslen, body, bodylen);
 =09=09} else {
 =09=09=09bounceaddr =3D bounce_from_adr(addr, listaddr, listdelim,
-=09=09=09=09=09=09     archivefilename);
+=09=09=09=09=09=09     archivefilename, listdir);
 =09=09=09res =3D send_mail(sockfd, bounceaddr, addr, replyto,
 =09=09=09=09  mailmap, mailsize, listdir, mlmmjbounce,
 =09=09=09=09  hdrs, hdrslen, body, bodylen);
@@ -929,7 +936,7 @@ int main(int argc, char **argv)
 =09=09deletewhensent =3D 0;
 =09=09archivefilename =3D mystrdup(mailfilename);
 =09=09bounceaddr =3D bounce_from_adr(to_addr, listaddr, listdelim,
-=09=09=09=09=09=09archivefilename);
+=09=09=09=09=09=09archivefilename, listdir);
 =09=09break;
 =09default: /* normal list mail -- now handled when forking */
 =09=09addtohdr =3D statctrl(listdir, "addtohdr");

